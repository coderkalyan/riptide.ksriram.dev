            <span class="ic" style="color:var(--clk)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5V12l3 1.8"></path></svg></span>
            <span class="nm">clk</span><span class="val">1</span>
          </div>
          <div class="as-row child">
            <span class="ic" style="color:var(--hot)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5v7"></path><path d="M6.7 6.4a8 8 0 1 0 10.6 0"></path></svg></span>
